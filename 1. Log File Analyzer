logs = [
    "ERROR: Disk full",
    "INFO: User logged in",
    "WARNING: CPU high",
    "ERROR: Memory leak",
    "INFO: File opened"
]

error_count = 0
warning_count = 0
info_count = 0

for log in logs:
    if "ERROR" in log:
        error_count += 1
    elif "WARNING" in log:
        warning_count += 1
    elif "INFO" in log:
        info_count += 1

print("ERROR:", error_count)
print("WARNING:", warning_count)
print("INFO:", info_count)

if error_count >= warning_count and error_count >= info_count:
    print("Most frequent: ERROR")
elif warning_count >= error_count and warning_count >= info_count:
    print("Most frequent: WARNING")
else:
    print("Most frequent: INFO")
